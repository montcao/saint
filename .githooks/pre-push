#!/bin/sh
# Runs the fast checks before a push: commitlint on each new commit, then
# gofmt, vet, the docs check and the structural tests on the working tree. The
# full race-enabled suite runs in CI. Installed per clone by `make hooks`.
set -eu

zero=0000000000000000000000000000000000000000

# The repository is public. Refuse commits whose added lines or messages
# contain this machine's home directory, the pusher's git email, or any value
# listed with `git config --add saint.personal <value>` (a real email behind a
# noreply address, a real name, a hostname). All are read here, at push time,
# from the contributor's own machine, so nothing personal is written into the
# repository to look for it.
personal_check() {
	email=$(git config user.email 2>/dev/null || true)
	{
		printf '%s\n' "$HOME"
		case "$email" in *noreply*) ;; *) printf '%s\n' "$email" ;; esac
		git config --get-all saint.personal 2>/dev/null || true
	} | while IFS= read -r needle; do
		[ -n "$needle" ] || continue
		if { git diff "$1" "$2" | grep '^+' ; git log --format=%B "$1..$2"; } | grep -qiF -- "$needle"; then
			echo "pre-push: a commit adds your home directory, git email or a saint.personal value; this repository is public." >&2
			echo "pre-push: find it with: git diff $1 $2 | grep -nF -- '<value>'   and   git log --format=%B $1..$2" >&2
			exit 1
		fi
	done || exit 1
}
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # deleting a branch
	# Lint what the branch adds on top of main. The old remote head is not a
	# usable base: after a rebase it is no longer an ancestor, and the range
	# from it would take in commits that are already on main.
	base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
	# Nothing new on this ref (already pushed, or a re-push of the same
	# commit): commitlint rejects an empty range, and there is nothing to lint.
	if [ -n "$base" ] && [ "$base" != "$local_sha" ] && [ "$remote_sha" != "$local_sha" ]; then
		make --no-print-directory -s commitlint-range FROM="$base" TO="$local_sha"
		personal_check "$base" "$local_sha"
	fi
done

make --no-print-directory -s fmt-check vet docs-check
go test -count=1 ./internal/archtest
