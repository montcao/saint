#!/bin/sh
# Runs the fast checks before a push: commitlint on each new commit, then
# gofmt, vet, the docs check and the structural tests on the working tree. The
# full race-enabled suite runs in CI. Installed per clone by `make hooks`.
set -eu

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # deleting a branch
	if [ "$remote_sha" = "$zero" ]; then
		# A new branch: lint what it adds on top of main.
		base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
	else
		base=$remote_sha
	fi
	# Nothing new on this ref (already pushed, or a re-push of the same
	# commit): commitlint rejects an empty range, and there is nothing to lint.
	if [ -n "$base" ] && [ "$base" != "$local_sha" ]; then
		make --no-print-directory -s commitlint-range FROM="$base" TO="$local_sha"
	fi
done

make --no-print-directory -s fmt-check vet docs-check
go test -count=1 ./internal/archtest
